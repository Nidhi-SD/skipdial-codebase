generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Neon, connected via the Vercel Storage integration — vars are prefixed
  // "database_" because that's the custom prefix the integration was given.
  // Pooled URL for normal app queries; the direct/unpooled one is required
  // for `prisma db push`/migrate, which can't run over a pgbouncer session.
  url       = env("database_POSTGRES_PRISMA_URL")
  directUrl = env("database_POSTGRES_URL_NON_POOLING")
}

model User {
  id       String  @id @default(cuid())
  name     String?
  email    String  @unique
  password String
  role     String  @default("user")

  // Client portal — company label shown in the dashboard header, and the one
  // voice-platform agent this client owns. The dashboard resolves the agent
  // id from here on every request, so a client can only ever read their own
  // agent's data; it is never accepted from the browser.
  //
  // A client's agent lives on exactly one platform. `provider` picks which
  // id column is authoritative; the other stays null. Two separate columns
  // (rather than one generic externalAgentId) because the two platforms'
  // ids aren't interchangeable and a stray value in the wrong column would
  // silently query the wrong API.
  company         String?
  provider        String  @default("vapi") // "vapi" | "retell"
  vapiAssistantId String?
  retellAgentId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id         String   @id
  title      String
  category   String
  excerpt    String
  content    String
  coverImage String
  authorName String
  date       DateTime @default(now())
}
